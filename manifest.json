{
  "manifest_version": 3,
  "name": "PromptForge - AI Prompt Optimizer & Token Saver",
  "version": "1.0.0",
  "description": "Convert rough thoughts into high-leverage prompts directly inside Claude, Copilot, ChatGPT, & Gemini. Saves tokens and eliminates conversational drift.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "PromptForge"
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://api.groq.com/*",
    "https://api.deepseek.com/*",
    "*://claude.ai/*",
    "*://chatgpt.com/*",
    "*://chat.openai.com/*",
    "*://copilot.microsoft.com/*",
    "*://www.perplexity.ai/*",
    "*://gemini.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://claude.ai/*",
        "*://chatgpt.com/*",
        "*://chat.openai.com/*",
        "*://copilot.microsoft.com/*",
        "*://www.perplexity.ai/*",
        "*://gemini.google.com/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "forge-prompt": {
      "suggested_key": {
        "default": "Alt+P",
        "mac": "Alt+P"
      },
      "description": "Forge prompt from rough thought with PromptForge"
    }
  }
}
